# Normalize trailing-slash version URLs to the canonical no-slash form,
# which functions/[version].js handles. Without this, Cloudflare's static
# asset server can try to resolve /vN/ as a directory (looking for
# vN/index.html) before the Function ever runs.
/v1/  /v1  301
/v2/  /v2  301
/v3/  /v3  301
/v4/  /v4  301
/v5/  /v5  301
/v6/  /v6  301
